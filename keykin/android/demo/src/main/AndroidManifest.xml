<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local stack only: the emulator reaches the host's relays at 10.0.2.2 over plain ws://. -->
    <application android:label="Keykin demo" android:usesCleartextTraffic="true" android:allowBackup="false">
        <activity android:name=".Main" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Tests drive the demo through this alias only: DUMP is the shell's, never an ordinary app's. -->
        <activity-alias android:name=".Drive" android:targetActivity=".Main" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Report a device lost and the paper check: in the signer process, beside the shares and the lock. -->
        <activity android:name=".Tools" android:process=":signer" android:exported="false" android:theme="@style/Theme.AppCompat.DayNight" />
        <!-- NIP-55's screen runs in the signer process, beside the provider and the shares. -->
        <activity android:name=".Nip55Activity" android:process=":signer" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostrsigner" />
            </intent-filter>
        </activity>
    </application>
</manifest>
