# Who runs this server: your npub. It's in the server's announcement (kind 30243), so
# apps can pick servers run by different people.
COSIGN_OPERATOR=npub1...

# Who may store a share here: open (anyone), invite (only COSIGN_INVITES: npubs, or
# device pubkeys in hex, comma separated), follows (whoever COSIGN_OWNER follows) or
# owner (nobody else). Leave it out and the server's own page chooses; a code from that
# page always works, whatever is set here.
COSIGN_ENROLL=open
# COSIGN_INVITES=

# The relays the server uses (comma separated): public ones that take short-lived
# events from any key.
# COSIGN_RELAYS=wss://syb.lol,wss://nos.lol,wss://relay.primal.net
