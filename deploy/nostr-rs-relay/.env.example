# Who runs this server: your npub. It's in the server's announcement (kind 30243), so
# apps can pick servers run by different people.
COSIGN_OPERATOR=npub1...

# Your relay's public address, as phones and sites reach it.
RELAY_URL=wss://relay.example.com

# Where this container reaches nostr-rs-relay, and the Docker network nostr-rs-relay is on.
# `docker network ls` and `docker ps` show them, if yours differ.
RELAY_INTERNAL=ws://nostr-rs-relay:8080
RELAY_NETWORK=nostr-rs-relay_default

# Who may store a share here: open (anyone) or invite (only COSIGN_INVITES, device
# pubkeys in hex, comma separated).
COSIGN_ENROLL=open
# COSIGN_INVITES=

# The other relays the server uses besides yours (comma separated). Left out, it uses
# wss://nos.lol and wss://relay.primal.net.
# EXTRA_RELAYS=wss://nos.lol,wss://relay.primal.net
