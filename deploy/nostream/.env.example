# Who runs this server: your npub. It's in the server's announcement (kind 30243), so
# apps can pick servers run by different people.
COSIGN_OPERATOR=npub1...

# Your relay's public address, as phones and sites reach it.
RELAY_URL=wss://relay.example.com

# Where this container reaches nostream, and the Docker network nostream is on.
# `docker network ls` and `docker ps` show them, if yours differ.
RELAY_INTERNAL=ws://nostream:8008
RELAY_NETWORK=nostream

# Who may store a share here: open (anyone), invite (only COSIGN_INVITES: npubs, or
# device pubkeys in hex, comma separated), follows (whoever COSIGN_OWNER follows) or
# owner (nobody else). Leave it out and the server's own page chooses; a code from that
# page always works, whatever is set here.
COSIGN_ENROLL=open
# COSIGN_INVITES=

# The other relays the server uses besides yours (comma separated). Left out, it uses
# wss://nos.lol and wss://relay.primal.net.
# EXTRA_RELAYS=wss://nos.lol,wss://relay.primal.net

# This server's address on nostream's network: the one to exempt in nostream's settings.
COSIGN_IP=10.10.10.10
